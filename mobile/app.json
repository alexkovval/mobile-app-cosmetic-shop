{
  "expo": {
    "name": "Cosmetics Store",
    "slug": "cosmetics-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FDF6F3"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan your card number at checkout (demo feature — nothing is uploaded or stored)."
      },
      "bundleIdentifier": "com.anonymous.cosmeticsstore"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDF6F3"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.cosmeticsstore"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan your card number at checkout (demo feature — nothing is uploaded or stored)."
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
